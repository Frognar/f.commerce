{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fcommerce;Username=fcommerce;Password=fcommerce"
  },
  "Database": {
    "ApplyChangesOnStartup": false
  },
  "Localization": {
    "DefaultCulture": "pl",
    "SupportedCultures": [
      "pl",
      "en"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Marten": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Search": {
    "StoragePath": "data/search"
  },
  "Media": {
    "StoragePath": "data/media"
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@fcommerce.local",
    "FromName": "f.commerce"
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "Platform": {
    "PublicUrl": "http://localhost:5180",
    "SellerName": "f.commerce"
  },
  "Storefront": {
    "CatalogVisibility": "Public"
  },
  "Security": {
    "AuthenticationAttemptsPerMinute": 10
  }
}
