{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fcommerce;Username=fcommerce;Password=fcommerce"
  },
  "Database": {
    "ApplyChangesOnStartup": false
  },
  "Localization": {
    "DefaultCulture": "pl",
    "SupportedCultures": [
      "pl",
      "en"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Marten": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Search": {
    "StoragePath": "data/search"
  },
  "Media": {
    "StoragePath": "data/media"
  }
}
