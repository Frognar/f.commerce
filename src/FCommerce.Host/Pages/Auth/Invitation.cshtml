@page "/invitation"
@model FCommerce.Host.Pages.Auth.InvitationModel
@{
    ViewData["Title"] = T["AcceptInvitation"];
}
<section class="narrow card">
    <h1>@T["AcceptInvitation"]</h1>
    @if (!Model.Valid)
    {
        <p class="alert" role="alert">@T["Error.token.invalid"]</p>
        <p><a asp-page="/Auth/SignIn">@T["SignIn"]</a></p>
    }
    else
    {
        <p>@T["InvitationLead", Model.Invitation.Name, Model.Invitation.Email]</p>
        <div asp-validation-summary="All" class="alert" role="alert"></div>
        <form method="post" class="stack">
            <input type="hidden" asp-for="Token" />
            <input type="email" value="@Model.Invitation.Email" autocomplete="username" hidden readonly />
            <label>@T["NewPassword"] <input asp-for="Password" type="password" autocomplete="new-password" minlength="12" required /></label>
            <label>@T["ConfirmPassword"] <input asp-for="Confirmation" type="password" autocomplete="new-password" required /></label>
            <p class="muted">@T["PasswordHint"]</p>
            <button class="button" type="submit">@T["ActivateAccount"]</button>
        </form>
    }
</section>
