@page "/forgot-password"
@model FCommerce.Host.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = T["ForgotPassword"];
}
<section class="narrow card">
    <h1>@T["ForgotPassword"]</h1>
    @if (Model.Sent)
    {
        <p role="status">@T["ResetLinkSent"]</p>
    }
    else
    {
        <p class="muted">@T["ForgotPasswordLead"]</p>
        <form method="post" class="stack">
            <label>@T["Email"] <input asp-for="Email" type="email" autocomplete="username" required /></label>
            <button class="button" type="submit">@T["SendResetLink"]</button>
        </form>
    }
</section>
