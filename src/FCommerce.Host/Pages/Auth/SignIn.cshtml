@page "/sign-in"
@model FCommerce.Host.Pages.Auth.SignInModel
@inject FCommerce.Application.Messaging.IQueryHandler<FCommerce.Settings.Contracts.GetPlatformSettings, FCommerce.Settings.Contracts.PlatformSettingsView> Settings
@{
    ViewData["Title"] = T["SignIn"];
    var platform = await Settings.HandleAsync(new FCommerce.Settings.Contracts.GetPlatformSettings());
}
<section class="narrow card">
    <h1>@T["SignIn"]</h1>
    @foreach (var failure in Model.Failure.AsEnumerable())
    {
        <p class="alert" role="alert">@failure</p>
    }
    <form method="post" class="stack">
        <input type="hidden" asp-for="ReturnUrl" />
        <label>@T["Email"] <input asp-for="Email" type="email" autocomplete="username" required /></label>
        <label>@T["Password"] <input asp-for="Password" type="password" autocomplete="current-password" required /></label>
        <label class="inline"><input asp-for="Remember" type="checkbox" /> @T["RememberMe"]</label>
        <button class="button" type="submit">@T["SignIn"]</button>
    </form>
    <p><a asp-page="/Auth/ForgotPassword">@T["ForgotPassword"]</a></p>
    @if (platform.IsOn("self-registration"))
    {
        <p>@T["NoAccountYet"] <a asp-page="/Auth/Register">@T["RegisterCompany"]</a></p>
    }
</section>
