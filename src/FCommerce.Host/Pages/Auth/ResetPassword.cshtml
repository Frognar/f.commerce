@page "/reset-password"
@model FCommerce.Host.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = T["ChooseNewPassword"];
}
<section class="narrow card">
    <h1>@T["ChooseNewPassword"]</h1>
    @if (Model.Done)
    {
        <p role="status">@T["PasswordChanged"]</p>
        <p><a class="button" asp-page="/Auth/SignIn">@T["SignIn"]</a></p>
    }
    else
    {
        <div asp-validation-summary="All" class="alert" role="alert"></div>
        <form method="post" class="stack">
            <input type="hidden" asp-for="Token" />
            <label>@T["NewPassword"] <input asp-for="Password" type="password" autocomplete="new-password" minlength="12" required /></label>
            <label>@T["ConfirmPassword"] <input asp-for="Confirmation" type="password" autocomplete="new-password" required /></label>
            <p class="muted">@T["PasswordHint"]</p>
            <button class="button" type="submit">@T["SavePassword"]</button>
        </form>
    }
</section>
