@page "/products/{**sku}"
@using FCommerce.Host.Media
@using FCommerce.Media.Contracts
@model FCommerce.Host.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Found ? Model.Product.Name : T["ProductNotFound"].Value;
}
@if (!Model.Found)
{
    <section class="hero">
        <h1>@T["ProductNotFound"]</h1>
        <p><a asp-page="/Catalog/Index">@T["BackToCatalog"]</a></p>
    </section>
}
else
{
    var product = Model.Product;
    <nav class="breadcrumb" aria-label="@T["Categories"]">
        <a asp-page="/Catalog/Index">@T["Catalog"]</a>
        @foreach (var category in product.CategoryPath)
        {
            <span aria-hidden="true">/</span>
            <a asp-page="/Catalog/Index" asp-route-category="@category.Code">@category.Name</a>
        }
    </nav>

    <article class="product">
        @if (product.ImageIds.Count == 0)
        {
            <div class="gallery">
                <div class="gallery-main"><img src="/img/placeholder.svg" alt="@T["NoImage"]" /></div>
            </div>
        }
        else
        {
            var first = product.ImageIds[0];
            <div class="gallery" data-gallery>
                <a class="gallery-main" href="@MediaEndpoints.ImageUrl(first, ImageVariantNames.Large)" data-gallery-main
                   aria-label="@T["EnlargeImage"]">
                    <img src="@MediaEndpoints.ImageUrl(first, ImageVariantNames.Medium)" alt="@product.Name" />
                </a>
                @if (product.ImageIds.Count > 1)
                {
                    <ul class="gallery-thumbs">
                        @for (var i = 0; i < product.ImageIds.Count; i++)
                        {
                            var id = product.ImageIds[i];
                            <li>
                                <button type="button" data-gallery-thumb="@i" aria-current="@(i == 0 ? "true" : null)"
                                        data-medium="@MediaEndpoints.ImageUrl(id, ImageVariantNames.Medium)"
                                        data-large="@MediaEndpoints.ImageUrl(id, ImageVariantNames.Large)"
                                        aria-label="@T["ImageOf", i + 1, product.ImageIds.Count]">
                                    <img src="@MediaEndpoints.ImageUrl(id, ImageVariantNames.Thumbnail)" alt="" loading="lazy" />
                                </button>
                            </li>
                        }
                    </ul>
                }
                <dialog class="lightbox" data-gallery-dialog aria-label="@product.Name">
                    <img alt="@product.Name" data-gallery-large />
                    <p class="lightbox-counter" data-gallery-counter></p>
                    <button type="button" class="lightbox-close" data-gallery-close aria-label="@T["Close"]">×</button>
                    @if (product.ImageIds.Count > 1)
                    {
                        <button type="button" class="lightbox-prev" data-gallery-prev aria-label="@T["PreviousImage"]">‹</button>
                        <button type="button" class="lightbox-next" data-gallery-next aria-label="@T["NextImage"]">›</button>
                    }
                </dialog>
            </div>
        }
        <div class="product-info">
            <h1>@product.Name</h1>
            <dl class="facts">
                <dt>@T["Sku"]</dt><dd>@product.Sku</dd>
                <dt>@T["Unit"]</dt><dd>@product.Unit</dd>
                @if (product.Gtin is not null)
                {
                    <dt>@T["Gtin"]</dt><dd>@product.Gtin</dd>
                }
            </dl>
            @if (product.Description is not null)
            {
                <h2>@T["Description"]</h2>
                <p class="description">@product.Description</p>
            }
            @if (product.Attributes.Count > 0)
            {
                <h2>@T["Attributes"]</h2>
                <table class="attributes">
                    <tbody>
                        @foreach (var spec in product.Attributes)
                        {
                            <tr><th scope="row">@spec.Name</th><td>@spec.Value</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </article>
}
