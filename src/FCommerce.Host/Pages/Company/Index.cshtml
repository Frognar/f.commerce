@page "/company"
@model FCommerce.Host.Pages.Company.IndexModel
@{
    ViewData["Title"] = T["MyCompany"];
}
@if (!Model.HasCompany)
{
    <h1>@T["MyCompany"]</h1>
    <p class="muted">@T["NoCompany"]</p>
}
@foreach (var customer in Model.Customer.AsEnumerable())
{
    <h1>@customer.Name</h1>
    <p class="muted">
        @customer.Code
        @if (customer.TaxId is not null)
        {
            <text>· @T["TaxId"] @customer.TaxId</text>
        }
    </p>
    @if (customer.Blocked)
    {
        <p class="alert" role="status">@T["CompanyBlocked"]</p>
    }
    @if (Model.CanSeeOrders || Model.CanSeeDocuments || Model.CanSeeUsers || Model.CanSeeApiKeys || Model.CanSeeShoppingLists)
    {
        <p class="actions">
            @if (Model.CanSeeOrders)
            {
                <a class="button secondary" asp-page="/Company/Orders/Index">@T["Orders"]</a>
            }
            @if (Model.CanSeeDocuments)
            {
                <a class="button secondary" asp-page="/Company/Documents">@T["Documents"]</a>
            }
            @if (Model.CanSeeShoppingLists)
            {
                <a class="button secondary" asp-page="/Company/Lists/Index">@T["ShoppingLists"]</a>
            }
            @if (Model.CanSeeUsers)
            {
                <a class="button secondary" asp-page="/Company/Users">@T["CompanyUsers"]</a>
            }
            @if (Model.CanSeeApiKeys)
            {
                <a class="button secondary" asp-page="/Company/ApiKeys">@T["ApiKeys"]</a>
            }
        </p>
    }
    <partial name="_CustomerProfile" model="customer" />
}
