@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject SupportedCultures Cultures
@inject FCommerce.Host.Security.CurrentUser CurrentUser
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    // Only culture-prefixed pages get alternates and a language switcher.
    var currentPage = ViewContext.RouteData.Values.ContainsKey(CultureRouteConvention.RouteKey)
        ? ViewContext.RouteData.Values["page"]?.ToString()
        : null;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var session = await CurrentUser.SessionAsync();
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · f.commerce</title>
    @if (currentPage is not null)
    {
        foreach (var alternate in Cultures.All)
        {
            <link rel="alternate" hreflang="@alternate" href="@Url.CurrentPageIn(ViewContext, alternate.Value)" />
        }
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true" defer></script>
    <script src="~/js/gallery.js" asp-append-version="true" defer></script>
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}'>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" asp-page="/Index">f.commerce <span class="brand-tagline">@T["Tagline"]</span></a>
            <nav class="main-nav">
                <a asp-page="/Catalog/Index">@T["Catalog"]</a>
            </nav>
            <nav class="user-menu" aria-label="@T["Account"]">
                @if (session is null)
                {
                    <a asp-page="/Auth/SignIn">@T["SignIn"]</a>
                }
                else
                {
                    @if (session.Operator is not null)
                    {
                        <a asp-page="/Admin/Index">@T["BackOffice"]</a>
                    }
                    <a asp-page="/Account/Index">@session.Name</a>
                    <form method="post" asp-page="/Auth/SignOut">
                        <button class="link" type="submit">@T["SignOut"]</button>
                    </form>
                }
            </nav>
            @if (currentPage is not null)
            {
                <nav class="language-switcher" aria-label="@T["Language"]">
                    @foreach (var option in Cultures.All)
                    {
                        <a href="@Url.CurrentPageIn(ViewContext, option.Value)"
                           aria-current="@(option.Value == culture ? "true" : null)">@option.Value.ToUpperInvariant()</a>
                    }
                </nav>
            }
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">© @DateTime.UtcNow.Year f.commerce</div>
    </footer>
</body>
</html>
