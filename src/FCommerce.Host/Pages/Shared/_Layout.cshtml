@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject SupportedCultures Cultures
@inject FCommerce.Host.Security.CurrentUser CurrentUser
@inject FCommerce.Application.Messaging.IQueryHandler<FCommerce.Settings.Contracts.GetPlatformSettings, FCommerce.Settings.Contracts.PlatformSettingsView> Settings
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    // Only culture-prefixed pages get alternates and a language switcher.
    var currentPage = ViewContext.RouteData.Values.ContainsKey(CultureRouteConvention.RouteKey)
        ? ViewContext.RouteData.Values["page"]?.ToString()
        : null;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var session = await CurrentUser.SessionAsync();
    var platform = await Settings.HandleAsync(new FCommerce.Settings.Contracts.GetPlatformSettings());
    var branding = platform.Branding;
    var membership = await CurrentUser.ActiveMembershipAsync();
    var companies = membership is null ? [] : await CurrentUser.CompaniesAsync();
    var canSwitch = companies.Count > 1 && platform.IsOn(FCommerce.SharedKernel.Features.Feature.MultiCustomerAccounts.Value);
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @branding.StoreName</title>
    @if (currentPage is not null)
    {
        foreach (var alternate in Cultures.All)
        {
            <link rel="alternate" hreflang="@alternate" href="@Url.CurrentPageIn(ViewContext, alternate.Value)" />
        }
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Branding: the accent is a validated #rrggbb value from the platform settings. *@
    <style>:root { --color-accent: @branding.AccentColor; }</style>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true" defer></script>
    <script src="~/js/gallery.js" asp-append-version="true" defer></script>
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}'>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" asp-page="/Index">
                @if (branding.LogoImageId is not null)
                {
                    <img class="brand-logo" src="@FCommerce.Host.Media.MediaEndpoints.ImageUrl(branding.LogoImageId, FCommerce.Media.Contracts.ImageVariantNames.Thumbnail)" alt="" />
                }
                @branding.StoreName <span class="brand-tagline">@T["Tagline"]</span>
            </a>
            <nav class="main-nav">
                <a asp-page="/Catalog/Index">@T["Catalog"]</a>
            </nav>
            <nav class="user-menu" aria-label="@T["Account"]">
                @if (session is null)
                {
                    <a asp-page="/Auth/SignIn">@T["SignIn"]</a>
                }
                else
                {
                    @if (session.Operator is not null)
                    {
                        <a asp-page="/Admin/Index">@T["BackOffice"]</a>
                    }
                    @if (membership is not null && canSwitch)
                    {
                        <form class="company-switcher" method="post" asp-page="/Company/Switch">
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <select name="code" aria-label="@T["SwitchCompany"]" onchange="this.form.requestSubmit()">
                                @foreach (var company in companies)
                                {
                                    <option value="@company.Code" selected="@(company.Code == membership.CustomerCode)">@company.Name</option>
                                }
                            </select>
                            <noscript><button class="link" type="submit">@T["SwitchCompany"]</button></noscript>
                        </form>
                        <a asp-page="/Company/Index">@T["MyCompany"]</a>
                    }
                    else if (membership is not null)
                    {
                        <a asp-page="/Company/Index">@(companies.FirstOrDefault(c => c.Code == membership.CustomerCode)?.Name ?? T["MyCompany"])</a>
                    }
                    <a asp-page="/Account/Index">@session.Name</a>
                    <form method="post" asp-page="/Auth/SignOut">
                        <button class="link" type="submit">@T["SignOut"]</button>
                    </form>
                }
            </nav>
            @if (currentPage is not null)
            {
                <nav class="language-switcher" aria-label="@T["Language"]">
                    @foreach (var option in Cultures.All)
                    {
                        <a href="@Url.CurrentPageIn(ViewContext, option.Value)"
                           aria-current="@(option.Value == culture ? "true" : null)">@option.Value.ToUpperInvariant()</a>
                    }
                </nav>
            }
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-row">
            <span>© @DateTime.UtcNow.Year @branding.StoreName</span>
            @if (platform.Contact.SupportEmail is not null)
            {
                <a href="mailto:@platform.Contact.SupportEmail">@platform.Contact.SupportEmail</a>
            }
            @if (platform.Contact.SupportPhone is not null)
            {
                <span>@platform.Contact.SupportPhone</span>
            }
        </div>
    </footer>
</body>
</html>
