@page "/admin"
@model FCommerce.Host.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["BackOffice"];
}
<h1>@T["BackOffice"]</h1>
<p class="muted">@T["BackOfficeLead"]</p>
<ul class="tiles">
    <li><a class="card tile" asp-page="/Admin/Customers/Index"><strong>@T["Customers"]</strong><span class="muted">@T["CustomersLead"]</span></a></li>
    @foreach (var pending in Model.PendingRegistrations.AsEnumerable())
    {
        <li><a class="card tile" asp-page="/Admin/Registrations/Index"><strong>@T["Registrations"] @if (pending > 0) { <span class="badge">@pending</span> }</strong><span class="muted">@T["RegistrationsLead"]</span></a></li>
    }
    @if (Model.CanManageSettings)
    {
        <li><a class="card tile" asp-page="/Admin/Settings"><strong>@T["PlatformSettings"]</strong><span class="muted">@T["PlatformSettingsLead"]</span></a></li>
    }
    @if (Model.CanManageOperators)
    {
        <li><a class="card tile" asp-page="/Admin/Operators"><strong>@T["Operators"]</strong><span class="muted">@T["OperatorsLead"]</span></a></li>
    }
</ul>
