@page "/admin"
@model FCommerce.Host.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["BackOffice"];
}
<h1>@T["BackOffice"]</h1>
<p class="muted">@T["BackOfficeLead"]</p>
<ul class="tiles">
    @if (Model.CanManageOperators)
    {
        <li><a class="card tile" asp-page="/Admin/Operators"><strong>@T["Operators"]</strong><span class="muted">@T["OperatorsLead"]</span></a></li>
    }
</ul>
