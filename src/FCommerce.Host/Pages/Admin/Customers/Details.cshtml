@page "/admin/customers/{**code}"
@model FCommerce.Host.Pages.Admin.Customers.DetailsModel
@{
    var customer = Model.Customer;
    ViewData["Title"] = customer?.Name ?? T["CustomerNotFound"];
}
<nav class="breadcrumb">
    <a asp-page="/Admin/Index">@T["BackOffice"]</a>
    <a asp-page="/Admin/Customers/Index">@T["Customers"]</a>
</nav>
@if (customer is null)
{
    <h1>@T["CustomerNotFound"]</h1>
    return;
}
<h1>@customer.Name</h1>
<p class="muted">
    @customer.Code
    @if (customer.TaxId is not null)
    {
        <text> · @T["TaxId"] @customer.TaxId</text>
    }
    @if (!customer.Active)
    {
        <span class="badge">@T["CustomerInactive"]</span>
    }
    @if (customer.Blocked)
    {
        <span class="badge">@T["CustomerBlocked"]</span>
    }
</p>

<div class="customer-cards">
    <section class="card">
        <h2>@T["BillingAddress"]</h2>
        <address>@customer.BillingAddress.Street<br />@customer.BillingAddress.PostalCode @customer.BillingAddress.City<br />@customer.BillingAddress.Country</address>
    </section>

    <section class="card">
        <h2>@T["CommercialTerms"]</h2>
        <dl class="terms">
            <dt>@T["PriceList"]</dt><dd>@(customer.PriceListCode ?? T["PlatformDefault"])</dd>
            <dt>@T["PaymentTerms"]</dt><dd>@(customer.PaymentTermDays is { } days ? T["Days", days] : "—")</dd>
            <dt>@T["Currency"]</dt><dd>@customer.Currency</dd>
        </dl>
    </section>

    <section class="card">
        <h2>@T["Salesperson"]</h2>
        @if (customer.Salesperson is { } salesperson)
        {
            <p>@salesperson.Name<br />
                @if (salesperson.Email is not null) { <a href="mailto:@salesperson.Email">@salesperson.Email</a><br /> }
                @salesperson.Phone</p>
        }
        else
        {
            <p class="muted">@T["NoSalesperson"]</p>
        }
    </section>
</div>

<h2>@T["DeliveryAddresses"]</h2>
@if (customer.DeliveryAddresses.Count == 0)
{
    <p class="muted">@T["NoDeliveryAddresses"]</p>
}
else
{
    <table class="data">
        <thead><tr><th>@T["AddressCode"]</th><th>@T["AddressName"]</th><th>@T["Address"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var address in customer.DeliveryAddresses)
            {
                <tr>
                    <td>@address.Code</td>
                    <td>@address.Name</td>
                    <td>@address.Address.Street, @address.Address.PostalCode @address.Address.City, @address.Address.Country</td>
                    <td>@if (address.IsDefault) { <span class="badge">@T["DefaultAddress"]</span> }</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@T["Contacts"]</h2>
@if (customer.Contacts.Count == 0)
{
    <p class="muted">@T["NoContacts"]</p>
}
else
{
    <table class="data">
        <thead><tr><th>@T["FullName"]</th><th>@T["Email"]</th><th>@T["Phone"]</th><th>@T["PortalAccess"]</th></tr></thead>
        <tbody>
            @foreach (var contact in customer.Contacts)
            {
                <tr>
                    <td>@contact.Name</td>
                    <td>@contact.Email</td>
                    <td>@contact.Phone</td>
                    <td>@(contact.PortalAccess ? T[$"Template.{contact.AttributeTemplate ?? "default"}"] : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}
<p class="muted">@T["UpdatedFromErp", customer.UpdatedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)]</p>
