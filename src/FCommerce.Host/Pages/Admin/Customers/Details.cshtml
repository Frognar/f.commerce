@page "/admin/customers/{**code}"
@model FCommerce.Host.Pages.Admin.Customers.DetailsModel
@{
    ViewData["Title"] = Model.Found ? Model.Customer.Name : T["CustomerNotFound"].Value;
}
<nav class="breadcrumb">
    <a asp-page="/Admin/Index">@T["BackOffice"]</a>
    <a asp-page="/Admin/Customers/Index">@T["Customers"]</a>
</nav>
@if (!Model.Found)
{
    <h1>@T["CustomerNotFound"]</h1>
    return;
}
@{
    var customer = Model.Customer;
}
<h1>@customer.Name</h1>
<p class="muted">
    @customer.Code
    @if (customer.TaxId is not null)
    {
        <text>· @T["TaxId"] @customer.TaxId</text>
    }
    @if (!customer.Active)
    {
        <span class="badge">@T["CustomerInactive"]</span>
    }
    @if (customer.Blocked)
    {
        <span class="badge">@T["CustomerBlocked"]</span>
    }
</p>
@foreach (var saved in Model.Saved.AsEnumerable())
{
    <p class="notice" role="status">@saved</p>
}
<div asp-validation-summary="All" class="alert" role="alert"></div>

<partial name="_CustomerProfile" model="customer" />

<h2>@T["Contacts"]</h2>
@if (customer.Contacts.Count == 0)
{
    <p class="muted">@T["NoContacts"]</p>
}
else
{
    <table class="data">
        <thead><tr><th>@T["FullName"]</th><th>@T["Email"]</th><th>@T["Phone"]</th><th>@T["PortalAccess"]</th></tr></thead>
        <tbody>
            @foreach (var contact in customer.Contacts)
            {
                <tr>
                    <td>@contact.Name</td>
                    <td>@contact.Email</td>
                    <td>@contact.Phone</td>
                    <td>@(contact.PortalAccess ? T[$"Template.{contact.AttributeTemplate ?? "default"}"] : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@foreach (var users in Model.Users.AsEnumerable())
{
    <h2>@T["PlatformUsers"]</h2>
    <partial name="_CustomerUsers" model="users" />
}

@foreach (var keys in Model.ApiKeys.AsEnumerable())
{
    <h2>@T["ApiKeys"]</h2>
    <partial name="_ApiKeys" model="keys" />
}

@if (Model.Audit.Count > 0)
{
    <h2>@T["AuditLog"]</h2>
    <table class="data">
        <thead><tr><th>@T["When"]</th><th>@T["Who"]</th><th>@T["WhatHappened"]</th><th>@T["Email"]</th></tr></thead>
        <tbody>
            @foreach (var entry in Model.Audit)
            {
                <tr>
                    <td>@entry.At.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)</td>
                    <td>@entry.Actor.ValueOr(T["SystemActor"])</td>
                    <td>@T[$"Audit.{entry.Action}"]</td>
                    <td>@entry.Email.ValueOr(string.Empty)</td>
                </tr>
            }
        </tbody>
    </table>
}
<p class="muted">@T["UpdatedFromErp", customer.UpdatedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)]</p>
