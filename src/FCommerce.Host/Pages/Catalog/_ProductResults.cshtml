@using FCommerce.Host.Media
@using FCommerce.Media.Contracts
@using FCommerce.Host.Pages.Catalog
@model FCommerce.Host.Pages.Catalog.IndexModel
@{
    var results = Model.Results;
}
@if (results.Facets.Count > 0)
{
    <div class="facets" aria-label="@T["Filters"]">
        @foreach (var facet in results.Facets)
        {
            <fieldset class="facet">
                <legend>@facet.Name</legend>
                @foreach (var value in facet.Values)
                {
                    <label class="facet-value">
                        <input type="checkbox" name="f" value="@FCommerce.Host.Pages.Catalog.IndexModel.FilterValue(facet.Code, value.Value)" checked="@value.Selected" />
                        <span>@value.Value</span> <span class="muted">(@value.Count)</span>
                    </label>
                }
            </fieldset>
        }
    </div>
}

<p class="muted">@T["ResultsCount", results.TotalCount]</p>

@if (results.Items.Count == 0)
{
    <p class="empty">@T["NoResults"]</p>
}
else
{
    <ul class="product-grid">
        @foreach (var product in results.Items)
        {
            <li class="product-card">
                <a asp-page="/Products/Details" asp-route-sku="@product.Sku">
                    <div class="product-image">
                        <img src="@(product.ImageId is null ? "/img/placeholder.svg" : MediaEndpoints.ImageUrl(product.ImageId, ImageVariantNames.Medium))" alt="" loading="lazy" />
                    </div>
                    <span class="product-name">@product.Name</span>
                </a>
                <span class="muted">@T["Sku"]: @product.Sku · @product.Unit</span>
                @if (product.Discontinued)
                {
                    <span class="badge discontinued">@T["Discontinued"]</span>
                }
                @foreach (var price in Model.Offers.PriceOf(product.Sku).AsEnumerable())
                {
                    <partial name="_PriceTag" model="new PriceTag(price, product.Unit, Model.SignInHref, Detailed: false)" />
                }
                @foreach (var stock in Model.Offers.StockOf(product.Sku, product.Unit).AsEnumerable())
                {
                    <partial name="_StockBadge" model="stock" />
                }
            </li>
        }
    </ul>
}

@if (results.PageCount > 1)
{
    <nav class="pagination" aria-label="@T["Pages"]">
        @if (results.Page > 1)
        {
            <a href="@Model.Href(page: results.Page - 1)" hx-get="@Model.Href(page: results.Page - 1)"
               hx-target="#@FCommerce.Host.Pages.Catalog.IndexModel.ResultsId" hx-push-url="true">@T["PreviousPage"]</a>
        }
        <span>@T["PageOf", results.Page, results.PageCount]</span>
        @if (results.Page < results.PageCount)
        {
            <a href="@Model.Href(page: results.Page + 1)" hx-get="@Model.Href(page: results.Page + 1)"
               hx-target="#@FCommerce.Host.Pages.Catalog.IndexModel.ResultsId" hx-push-url="true">@T["NextPage"]</a>
        }
    </nav>
}
