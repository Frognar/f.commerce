@page "/catalog"
@model FCommerce.Host.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = T["Catalog"];
}
<div class="catalog">
    <aside class="catalog-sidebar" aria-label="@T["Categories"]">
        <h2>@T["Categories"]</h2>
        <ul class="category-tree">
            <li><a href="@Model.Href(keepCategory: false, keepFilters: false)"
                   aria-current="@(Model.Category is null ? "page" : null)">@T["AllCategories"]</a></li>
            <partial name="_CategoryTree" model="(Model, Model.Categories)" />
        </ul>
    </aside>

    <form class="catalog-main" role="search" method="get" action="@Url.CulturePage("/Catalog/Index")"
          hx-get="@Url.CulturePage("/Catalog/Index")" hx-target="#@IndexModel.ResultsId" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:find input[name=q], change from:find input[name=f], submit">
        <h1>@T["Catalog"]</h1>
        <div class="search">
            <input type="search" name="q" value="@Model.Query" placeholder="@T["SearchPlaceholder"]"
                   aria-label="@T["SearchPlaceholder"]" autocomplete="off" />
            @if (Model.Category is not null)
            {
                <input type="hidden" name="category" value="@Model.Category" />
            }
            <button class="button" type="submit">@T["SearchButton"]</button>
        </div>

        <div id="@IndexModel.ResultsId" aria-live="polite">
            <partial name="_ProductResults" model="Model" />
        </div>
    </form>
</div>
