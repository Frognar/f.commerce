<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Pure projects (SharedKernel, every *.Domain and *.Core): the functional core.
    BannedApiAnalyzers turns any use of clocks, randomness, IO or ambient state into a compile error.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FCommerce.SharedKernel' Or $(MSBuildProjectName.EndsWith('.Domain')) Or $(MSBuildProjectName.EndsWith('.Core'))">
    <IsPureProject>true</IsPureProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPureProject)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/BannedSymbols.Pure.txt" Link="BannedSymbols.Pure.txt" />
  </ItemGroup>

  <!--
    Every production project (not tests): enums are read only through Enums.Parse / Stored.Enum, which accept the
    declared names and nothing else, so no value is ever silently replaced by a default.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) And '$(MSBuildProjectName)' != 'FCommerce.Testing'">
    <IsProductionProject>true</IsProductionProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPureProject)' == 'true' Or '$(IsProductionProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsProductionProject)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/BannedSymbols.Enums.txt" Link="BannedSymbols.Enums.txt" />
  </ItemGroup>
</Project>
